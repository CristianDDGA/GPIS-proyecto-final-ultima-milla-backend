# Web de Millast (React + Vite) servida por nginx. Contexto: la carpeta del repositorio del frontend.
FROM node:24.22.2-alpine AS build
WORKDIR /app
# El binario de Cypress no hace falta para compilar.
ENV CYPRESS_INSTALL_BINARY=0
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY . .
# Vite incrusta estas variables en el código al compilar.
ARG VITE_API_BASE_URL
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN npm run build

FROM nginx:alpine
# "cfg" es la carpeta deploy/local (contexto adicional definido en compose.yaml).
COPY --from=cfg nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
