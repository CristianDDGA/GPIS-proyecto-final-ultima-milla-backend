PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
# Credenciales del rol de aplicación de la base local.
DATABASE_URL=postgresql://logistica_app:REEMPLAZAR@127.0.0.1:15432/logistica
# Base de datos gestionada (Supabase): ver docs/deploy/supabase-render.md. Sin estas variables el comportamiento local no cambia.
# Con el pooler de Supabase el usuario es logistica_app.<id-del-proyecto> y el puerto es 6543.
# DB_SSL=require                    # disable | require | verify
# DB_SSL_CA=                        # con verify: certificado CA en PEM (con \n) o ruta al archivo
# DB_POOL_MAX=25                    # en el plan gratuito de Supabase conviene 10
# DB_SEND_STATEMENT_TIMEOUT=true    # false si el pooler rechaza parámetros de arranque (el rol ya fija statement_timeout)
# Solo para scripts/supabase/apply-migrations.mjs: conexión DIRECTA (5432) con el usuario postgres. No la uses en la API.
# MIGRATION_DATABASE_URL=
# Primer administrador (scripts/supabase/create-admin.mjs): ADMIN_EMAIL, ADMIN_PASSWORD (12+ caracteres) y ADMIN_NAME opcional.
# Pon estas variables solo en tu terminal; no dejes la contraseña guardada en un archivo.
# Ruta del paquete de base de datos descomprimido fuera del backend.
# Las rutas relativas parten de la raíz del backend. También se acepta una ruta absoluta.
DATABASE_PACKAGE_DIR=../db-proyecto
# Secreto HMAC para firmar tokens JWT. OBLIGATORIO: mínimo 32 caracteres, aleatorio y distinto en cada entorno.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Vigencia del token de sesión en segundos (por defecto 28800 = 8 horas).
JWT_EXPIRES_IN_SECONDS=28800

# Verificación de correo. true (por defecto): los clientes confirman su correo con un código de 6 dígitos.
# false = modo demo/pruebas de carga: los clientes quedan verificados al registrarse y no se envía correo.
EMAIL_VERIFICATION_REQUIRED=true
# Servidor SMTP (Brevo, Resend, SendGrid u otro). Sin SMTP_HOST los correos se escriben en la consola (solo desarrollo).
# Brevo: smtp-relay.brevo.com:587 | Resend: smtp.resend.com:465 (usuario "resend") | SendGrid: smtp.sendgrid.net:587 (usuario "apikey").
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Bloqueo por cuenta: tras LOGIN_MAX_FAILED_ATTEMPTS fallos de login en 15 minutos, la cuenta se bloquea LOGIN_LOCK_SECONDS.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300

# Carpeta privada para las imágenes (licencia y foto) de las solicitudes de conductor. Nunca se sirve como estática.
COURIER_UPLOADS_DIR=./storage/courier-applications
# Carpeta de las imágenes de los productos de la tienda (solo con STORAGE_DRIVER=disk).
PRODUCT_UPLOADS_DIR=./storage/product-images

# Dónde viven las imágenes: disk (por defecto, desarrollo) o supabase (nube). En Render el disco se borra al reiniciar:
# allí usa supabase. Ver docs/deploy/supabase-render.md.
STORAGE_DRIVER=disk
# Solo con STORAGE_DRIVER=supabase. La clave de servicio da control total del almacenamiento: va SOLO en las variables
# de entorno del servidor (Render), nunca en el frontend ni en git.
# SUPABASE_URL=https://<id-del-proyecto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PRODUCT_BUCKET=product-images       # bucket PÚBLICO (catálogo)
# SUPABASE_COURIER_BUCKET=courier-applications # bucket PRIVADO (licencia y foto de conductores)

# Inicio de sesión con Google (opcional). Client ID de OAuth tipo "Aplicación web" de Google Cloud (es público, no un secreto).
# Sin esta variable POST /auth/google responde 503 y el frontend debe ocultar el botón. Ver docs/contracts/auth-accounts.md.
# GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
