PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
# Credenciales del rol de aplicación de la base local.
DATABASE_URL=postgresql://logistica_app:REEMPLAZAR@127.0.0.1:15432/logistica
# Ruta del paquete de base de datos descomprimido fuera del backend.
# Las rutas relativas parten de la raíz del backend. También se acepta una ruta absoluta.
DATABASE_PACKAGE_DIR=../db-proyecto
# Secreto HMAC para firmar tokens JWT (mínimo 16 caracteres; obligatorio en producción).
JWT_SECRET=REEMPLAZAR_CON_SECRETO_SEGURO_DE_AL_MENOS_16_CHARS
JWT_EXPIRES_IN_SECONDS=86400
