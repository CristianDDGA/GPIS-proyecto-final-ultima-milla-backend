{
  "name": "gpis-ultima-milla-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import=tsx --watch src/bootstrap/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand",
    "start": "node --env-file-if-exists=.env dist/bootstrap/server.js",
    "db:generate": "prisma generate",
    "db:introspect": "node --env-file-if-exists=.env node_modules/prisma/build/index.js db pull",
    "test:integration:postgres": "node --env-file-if-exists=.env scripts/run-postgres-integration.mjs",
    "postinstall": "prisma generate",
    "db:verify": "node --env-file-if-exists=.env scripts/verify-database-package.mjs",
    
    "test:unit": "node --import=tsx --test test/unit/*.test.ts",

    "db:seed:volume": "node --env-file-if-exists=.env scripts/seed-volume.mjs",
    "test:load": "k6 run scripts/k6/smoke.k6.js",
    "test:stress": "k6 run scripts/k6/san-valentin-stress.k6.js",
    "test:security:zap": "node scripts/security/run-zap-baseline.mjs"

  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
